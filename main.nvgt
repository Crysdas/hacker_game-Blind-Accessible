// Locale selector must be visible to all includes (menu.nvgt, commands.nvgt...)
int ui_lang = 0; // 0 русский, 1 английский

string tr(string en, string ru) {
	if (ui_lang == 1) return en;
	return ru;
}

// Touch screen support (Android/iOS): swipes and taps become key events.
#include "touch.nvgt"
touch_gesture_manager g_touch;

#include "speech.nvgt"
#include "src/audio.nvgt"
#include "src/terminal.nvgt"
#include "src/network.nvgt"
#include "src/hacking.nvgt"
#include "src/menu.nvgt"
#include "src/story.nvgt"
#include "src/sandbox.nvgt"
#include "src/data.nvgt"
#include "src/log.nvgt"
#include "src/commands.nvgt"
#pragma asset "sounds"
#pragma compiled_basename "hacksim"

enum FocusArea {
	FOCUS_TERMINAL,
	FOCUS_RESULTS
};

enum GameMode {
	MODE_NONE,
	MODE_STORY,
	MODE_SANDBOX,
	MODE_LAB
};

// PACK_CONST

const string SETTINGS_FILE = "hacksim_settings.txt";
int music_level = 2; // 0 выкл, 1 тихая, 2 громкая
bool sfx_enabled = true;
int voice_mode = 0; // 0 скринридер (NVDA), 1 системный голос (SAPI)
int speech_language = 0; // 0 русский, 1 английский
int speech_volume = 0; // 0 норма, 1 громко, 2 тише

class HackerGame {
	private AudioManager@ audio;
	private Terminal@ terminal;
	private Network@ network;
	private HackingGame@ hacking;
	private GameMenu@ game_menu;
	private ContextMenu@ context_menu;
	private StoryManager@ story;
	private Sandbox@ sandbox;
	private Tools@ tools;
	private Logger@ log;

	private FocusArea focus;
	private GameMode mode;
	private bool running;
	private int current_server;
	private bool connected;
	private string cmd_buffer;
	private sound@ music_player;
	// PACK_FIELD

	private Command@[] commands;
	private ScanCommand@ cmd_scan;
	private ConnectCommand@ cmd_connect;
	private EnumCommand@ cmd_enum;
	private BruteforceCommand@ cmd_bruteforce;
	private CrackCommand@ cmd_crack;
	private FirewallCommand@ cmd_firewall;
	private SpamCommand@ cmd_spam;
	private DownloadCommand@ cmd_download;
	private HelpCommand@ cmd_help;
	private DisconnectCommand@ cmd_disconnect;

	HackerGame() {
		@log = Logger();
		log.start();
		log.log("HackerGame constructor");

		// PACK_BOOTSTRAP

		@audio = AudioManager();
		try {
			audio.load_sounds();
			log.log("Audio loaded OK");
		} catch {
			log.log("Audio load FAILED: " + get_exception_info());
		}
		sound@ bgm = sound();
		if (bgm.load("sounds/music/battle_with_shadow.ogg")) {
			@music_player = @bgm;
			log.log("Music loaded");
		} else {
			log.log("Music load FAILED (battle_with_shadow.ogg)");
		}

		@terminal = Terminal(@audio);
		@network = Network();
		@hacking = HackingGame(@audio);
		@game_menu = GameMenu(@audio);
		@context_menu = ContextMenu(@audio);
		@story = StoryManager();
		@sandbox = Sandbox(@audio);
		@tools = Tools();
		setup_touch();
		load_settings();
		audio.set_sfx_enabled(sfx_enabled);
		init_tts_voice();
		log.log("All subsystems initialized");

		@cmd_scan = ScanCommand();
		@cmd_connect = ConnectCommand();
		@cmd_enum = EnumCommand();
		@cmd_bruteforce = BruteforceCommand();
		@cmd_crack = CrackCommand();
		@cmd_firewall = FirewallCommand();
		@cmd_spam = SpamCommand();
		@cmd_download = DownloadCommand();
		@cmd_help = HelpCommand();
		@cmd_disconnect = DisconnectCommand();

		commands.resize(10);
		@commands[0] = @cmd_scan;
		@commands[1] = @cmd_connect;
		@commands[2] = @cmd_enum;
		@commands[3] = @cmd_bruteforce;
		@commands[4] = @cmd_crack;
		@commands[5] = @cmd_firewall;
		@commands[6] = @cmd_spam;
		@commands[7] = @cmd_download;
		@commands[8] = @cmd_help;
		@commands[9] = @cmd_disconnect;

		for (uint i = 0; i < commands.length(); i++) {
			commands[i].setup(@audio, @network, @hacking, @story, @sandbox);
		}

		focus = FOCUS_TERMINAL;
		mode = MODE_NONE;
		running = true;
		current_server = -1;
		connected = false;
		cmd_buffer = "";
		log.log("Constructor complete");
	}

	void run() {
		log.log("run()");
		try {
			show_splash();
			show_title();

			while (running) {
				wait(5);
g_touch.monitor();
				handle_input();
			}
		} catch {
			log.log("CRASH: " + get_exception_info());
		}
		log.log("Game loop ended");
		if (@music_player != null) music_player.stop();
		destroy_window();
		log.stop();
	}

private void setup_touch() {
		// Android/iOS gestures: left/right move in menus, up = back,
		// double tap = select. Desktop is unaffected (no touch screen).
		// 1- and 2-finger swipes both mapped for reliability on phones.
		g_touch.add_touch_interface(touch_keyboard_interface(g_touch, {
			{"swipe_left1f", KEY_UP},
			{"swipe_right1f", KEY_DOWN},
			{"swipe_up1f", KEY_ESCAPE},
			{"swipe_left2f", KEY_UP},
			{"swipe_right2f", KEY_DOWN},
			{"double_tap1f", KEY_RETURN},
			{"double_tap2f", KEY_RETURN}
		}));
	}

	private void show_splash() {
		log.log("show_splash()");
		show_window("Hacker Simulator: Zero Day");
		set_application_name("Hacker Simulator: Zero Day");
		if (system_is_mobile && screen_reader_has_speech()) {
			audio.speak(tr("A screen reader is active. Please turn it off for the best experience, the game uses its own touch gestures.", "Включён экранный диктор. Пожалуйста, выключите его: игра использует собственные жесты."), true);
			wait_skip(3000);
		}
		audio.play_sound("logo_riser");
		if (wait_skip(2150)) return;
		audio.play_sound("logo_hit");
		if (wait_skip(160)) return;
		audio.play_sound("logo_chime");
		if (wait_skip(700)) return;
		audio.play_sound("logo_sparkle");
		if (wait_skip(1900)) return;
		audio.speak("Dich Maker Team представляет", true);
		if (wait_skip(800)) return;
		audio.success_beep();
		wait_skip(1400);
	}

	// Waits ms; returns true if the player pressed Enter/Space to skip.
	private bool wait_skip(int ms) {
		timer t;
		while (t.elapsed < uint(ms)) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_RETURN) || key_pressed(KEY_SPACE)) return true;
		}
		return false;
	}

	private void show_title() {
		log.log("show_title()");
		audio.speak("Hacker Simulator: Zero Day", true);
		wait(500);
		show_main_menu();
	}

	private void show_main_menu() {
		log.log("show_main_menu()");
		mode = MODE_NONE;
		start_menu_music();
		string[] items = {
			tr("Story — 10 missions", "Сюжет — 10 миссий"),
			tr("Sandbox — free play", "Песочница — свободная игра"),
			tr("Lab — training", "Лаборатория — тренировка"),
			tr("Settings", "Настройки"),
			tr("Exit", "Выход")
		};
		game_menu.set_items(items);
		game_menu.open();

		while (game_menu.is_active()) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_UP)) game_menu.move_up();
			if (key_pressed(KEY_DOWN)) game_menu.move_down();
			if (key_pressed(KEY_HOME)) game_menu.move_first();
			if (key_pressed(KEY_END)) game_menu.move_last();
			if (key_pressed(KEY_PAGEUP)) music_adjust(1);
			if (key_pressed(KEY_PAGEDOWN)) music_adjust(-1);
			if (key_pressed(KEY_RETURN)) {
				int sel = game_menu.get_selected();
				game_menu.close();
				log.log("Main menu selected: " + sel);
				if (sel == 0) start_story();
				else if (sel == 1) start_sandbox();
				else if (sel == 2) start_lab();
				else if (sel == 3) show_settings_menu();
				else if (sel == 4) {
					log.log("Quit selected");
					running = false;
				}
				return;
			}
			if (key_pressed(KEY_ESCAPE)) {
				if (mode != MODE_NONE) {
					game_menu.close();
					return;
				}
			}
			if (key_pressed(KEY_LEFT)) {
				audio.history_back();
			}
			if (key_pressed(KEY_RIGHT)) {
				audio.history_forward();
			}
		}
	}

	private void start_story() {
		log.log("start_story()");
		mode = MODE_STORY;
		stop_menu_music();
		audio.speak(tr("Story mode. You are a freelance hacker. Your client will contact you.", "Сюжетный режим. Вы хакер-фрилансер. Ваш клиент свяжется с вами."), true);
		wait(500);
		Mission@ m = story.get_current_mission();
		if (@m != null) {
			log.log("Mission: " + m.title);
			audio.speak(tr("Mission ", "Миссия ") + (story.get_current_index() + 1) + ": " + m.title, true);
			wait(300);
			audio.speak(m.description, true);
		} else {
			log.log("ERROR: Mission is null!");
		}
		begin_terminal();
	}

	private void start_sandbox() {
		log.log("start_sandbox()");
		mode = MODE_SANDBOX;
		stop_menu_music();
		set_sandbox_params();
		init_sandbox_network();
		begin_terminal();
	}

	private void set_sandbox_params() {
		string[] scenario_types = {
			tr("Network — hack servers", "Сеть — взлом серверов"),
			tr("People — social engineering", "Люди — социальная инженерия"),
			tr("Systems — hack infrastructure", "Системы — взлом инфраструктуры")
		};
		string target_type = "server";
		int servers = 5, ids = 1;

		audio.speak(tr("Choose a scenario: arrows, Enter to confirm.", "Выберите сценарий: стрелки, Enter — подтвердить."), true);
		wait(300);
		int sel = 0;
		bool sc_done = false;
		while (!sc_done) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_UP)) { sel = sel > 0 ? sel - 1 : 2; audio.speak(scenario_types[sel], true); wait(120); }
			if (key_pressed(KEY_DOWN)) { sel = sel < 2 ? sel + 1 : 0; audio.speak(scenario_types[sel], true); wait(120); }
			if (key_pressed(KEY_RETURN)) {
				if (sel == 0) target_type = "server";
				else if (sel == 1) target_type = "person";
				else target_type = "system";
				sc_done = true;
			}
			if (key_pressed(KEY_ESCAPE)) {
				target_type = "server"; sc_done = true;
			}
			if (key_pressed(KEY_LEFT)) { audio.history_back(); }
			if (key_pressed(KEY_RIGHT)) { audio.history_forward(); }
		}

		audio.speak(tr("Target count: arrows, Enter to confirm.", "Число целей: стрелки, Enter — подтвердить."), true);
		wait(200);
		bool done = false;
		while (!done) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_UP)) {
				servers = servers < 20 ? servers + 1 : 3;
				audio.speak("" + servers + tr(" targets", " целей"), true);
				wait(120);
			}
			if (key_pressed(KEY_DOWN)) {
				servers = servers > 3 ? servers - 1 : 20;
				audio.speak("" + servers + tr(" targets", " целей"), true);
				wait(120);
			}
			if (key_pressed(KEY_RETURN)) {
				audio.speak(tr("Defense difficulty: arrows — change, Enter — done.", "Сложность защиты: стрелки — изменить, Enter — готово."), true);
				wait(200);
				bool done_ids = false;
				while (!done_ids) {
					wait(5);
g_touch.monitor();
					if (key_pressed(KEY_UP)) {
						ids = ids < 5 ? ids + 1 : 0;
						audio.speak(tr("Difficulty ", "Сложность ") + ids, true);
						wait(120);
					}
					if (key_pressed(KEY_DOWN)) {
						ids = ids > 0 ? ids - 1 : 5;
						audio.speak(tr("Difficulty ", "Сложность ") + ids, true);
						wait(120);
					}
					if (key_pressed(KEY_RETURN)) {
						done_ids = true;
					}
					if (key_pressed(KEY_ESCAPE)) {
						audio.speak(tr("Setup cancelled", "Настройка отменена"), true);
						servers = 5; ids = 1; target_type = "server";
						done_ids = true;
					}
					if (key_pressed(KEY_LEFT)) { audio.history_back(); }
					if (key_pressed(KEY_RIGHT)) { audio.history_forward(); }
				}
				done = true;
			}
			if (key_pressed(KEY_ESCAPE)) {
				audio.speak(tr("Setup cancelled", "Настройка отменена"), true);
				servers = 5; ids = 1; target_type = "server";
				done = true;
			}
			if (key_pressed(KEY_LEFT)) { audio.history_back(); }
			if (key_pressed(KEY_RIGHT)) { audio.history_forward(); }
		}
		sandbox.configure(servers, ids);
		string type_name = target_type == "person" ? tr("social engineering", "социальной инженерии") : target_type == "system" ? tr("systems", "систем") : tr("servers", "серверов");
		sandbox.set_target_type(target_type);
		sandbox.start();
		audio.speak(tr("Sandbox: ", "Песочница: ") + servers + tr(" targets, type: ", " целей, тип: ") + type_name + tr(", difficulty ", ", сложность ") + ids + ".", true);
	}

	private void init_sandbox_network() {
		network.generate_scenario(sandbox.get_server_count(), sandbox.get_target_type(), sandbox.get_ids_level());
		wait(200);
		audio.speak(tr("Generated ", "Сгенерировано ") + sandbox.get_server_count() + tr(" targets.", " целей."), false);
	}

	private void start_lab() {
		log.log("start_lab()");
		mode = MODE_LAB;
		stop_menu_music();
		audio.speak("Лаборатория. Тренировка навыков взлома.", true);
		wait(200);
		show_lab_menu();
	}

	private void apply_music_volume() {
		if (@music_player == null) return;
		if (music_level == 0) {
			if (music_player.playing) music_player.stop();
		} else {
			music_player.volume = music_level == 1 ? -18.0 : -10.0;
			if (!music_player.playing) music_player.play_looped();
		}
	}

	private void start_menu_music() {
		if (@music_player == null) return;
		if (music_level > 0 && !music_player.playing) {
			music_player.volume = music_level == 1 ? -18.0 : -10.0;
			music_player.play_looped();
		}
	}

	private void stop_menu_music() {
		if (@music_player != null && music_player.playing) music_player.stop();
	}

	private void save_settings() {
		file f;
		if (f.open(SETTINGS_FILE, "w")) {
			f.write("music=" + music_level + "\n");
			f.write("sfx=" + (sfx_enabled ? "1" : "0") + "\n");
			f.write("voice=" + voice_mode + "\n");
			f.write("lang=" + speech_language + "\n");
			f.write("spkv=" + speech_volume + "\n");
			f.write("uilang=" + ui_lang + "\n");
			f.close();
			log.log("Settings saved");
		} else {
			log.log("Settings save FAILED");
		}
	}

	private void load_settings() {
		file f;
		if (f.open(SETTINGS_FILE, "r")) {
			string line = f.read_line();
			while (!line.is_empty()) {
				int eq = line.find("=");
				if (eq > 0) {
					string key = line.substr(0, eq);
					string val = line.substr(eq + 1, 1);
					if (key == "music") music_level = parse_int(val);
					else if (key == "sfx") sfx_enabled = parse_int(val) != 0;
					else if (key == "voice") voice_mode = parse_int(val);
					else if (key == "lang") speech_language = parse_int(val);
					else if (key == "spkv") speech_volume = parse_int(val);
					else if (key == "uilang") ui_lang = parse_int(val);
				}
				line = f.read_line();
			}
			f.close();
			if (music_level < 0) music_level = 0;
			if (music_level > 2) music_level = 2;
			if (voice_mode < 0) voice_mode = 0;
			if (voice_mode > 1) voice_mode = 1;
			if (speech_language < 0) speech_language = 0;
			if (speech_language > 1) speech_language = 1;
			if (speech_volume < 0) speech_volume = 0;
			if (speech_volume > 2) speech_volume = 2;
			if (ui_lang < 0) ui_lang = 0;
			if (ui_lang > 1) ui_lang = 1;
			log.log("Settings loaded: music=" + music_level + ", sfx=" + (sfx_enabled ? "1" : "0") + ", voice=" + voice_mode + ", lang=" + speech_language + ", spkv=" + speech_volume);
		} else {
			log.log("No settings file, using defaults");
		}
	}

	private string music_label() {
		if (music_level == 0) return "выключена";
		if (music_level == 1) return "тихая";
		return "громкая";
	}

	private string voice_label() {
		if (voice_mode == 0) return tr("Screen reader (NVDA)", "Скринридер (NVDA)");
		return tr("System voice (SAPI)", "Системный голос (SAPI)");
	}

	private string lang_label() {
		if (speech_language == 0) return "Русский";
		return "English";
	}

	private string ui_lang_label() {
		if (ui_lang == 0) return "Русский";
		return "English";
	}

	private string speech_vol_label() {
		if (speech_volume == 1) return tr("loud", "громко");
		if (speech_volume == 2) return tr("quiet", "тише");
		return tr("normal", "норма");
	}

	private void show_settings_menu() {
		string[] items = {
			tr("Music: ", "Музыка: ") + music_label(),
			tr("Sounds: ", "Звуки: ") + (sfx_enabled ? tr("on", "включены") : tr("off", "выключены")),
			tr("Voice: ", "Голос: ") + voice_label(),
			tr("Speech language: ", "Язык речи: ") + lang_label(),
			tr("Speech loudness: ", "Громкость речи: ") + speech_vol_label(),
			tr("Interface language: ", "Язык интерфейса: ") + ui_lang_label(),
			tr("Back to menu", "Вернуться в меню")
		};
		game_menu.set_items(items);
		game_menu.open();

		while (game_menu.is_active()) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_UP)) game_menu.move_up();
			if (key_pressed(KEY_DOWN)) game_menu.move_down();
			if (key_pressed(KEY_HOME)) game_menu.move_first();
			if (key_pressed(KEY_END)) game_menu.move_last();
			if (key_pressed(KEY_PAGEUP)) music_adjust(1);
			if (key_pressed(KEY_PAGEDOWN)) music_adjust(-1);
			if (key_pressed(KEY_RETURN)) {
				int sel = game_menu.get_selected();
				if (sel == 0) {
					music_level = (music_level + 1) % 3;
					apply_music_volume();
					save_settings();
					game_menu.set_item(0, tr("Music: ", "Музыка: ") + music_label());
					audio.speak(tr("Music: ", "Музыка: ") + music_label(), true);
				} else if (sel == 1) {
					sfx_enabled = !sfx_enabled;
					audio.set_sfx_enabled(sfx_enabled);
					save_settings();
					game_menu.set_item(1, tr("Sounds: ", "Звуки: ") + (sfx_enabled ? tr("on", "включены") : tr("off", "выключены")));
					audio.speak(tr("Sounds: ", "Звуки: ") + (sfx_enabled ? tr("on", "включены") : tr("off", "выключены")), true);
				} else if (sel == 2) {
					voice_mode = (voice_mode + 1) % 2;
					init_tts_voice();
					save_settings();
					game_menu.set_item(2, tr("Voice: ", "Голос: ") + voice_label());
					audio.speak(tr("Voice: ", "Голос: ") + voice_label(), true);
					audio.speak(tr("Voice check. One, two, three.", "Проверка голоса. Раз, два, три."), true);
				} else if (sel == 3) {
					speech_language = (speech_language + 1) % 2;
					init_tts_voice();
					save_settings();
					game_menu.set_item(3, tr("Speech language: ", "Язык речи: ") + lang_label());
					audio.speak(tr("Speech language: ", "Язык речи: ") + lang_label(), true);
					audio.speak(tr("Voice check. One, two, three.", "Проверка. Раз, два, три."), true);
				} else if (sel == 4) {
					speech_volume = (speech_volume + 1) % 3;
					init_tts_voice();
					save_settings();
					game_menu.set_item(4, tr("Speech loudness: ", "Громкость речи: ") + speech_vol_label());
					audio.speak(tr("Speech loudness: ", "Громкость речи: ") + speech_vol_label(), true);
					audio.speak(tr("Test", "Проверка"), true);
				} else if (sel == 5) {
					ui_lang = (ui_lang + 1) % 2;
					// Keep the spoken voice in sync with the interface language
					speech_language = ui_lang;
					init_tts_voice();
					save_settings();
					string[] back = {
						tr("Music: ", "Музыка: ") + music_label(),
						tr("Sounds: ", "Звуки: ") + (sfx_enabled ? tr("on", "включены") : tr("off", "выключены")),
						tr("Voice: ", "Голос: ") + voice_label(),
						tr("Speech language: ", "Язык речи: ") + lang_label(),
						tr("Speech loudness: ", "Громкость речи: ") + speech_vol_label(),
						tr("Interface language: ", "Язык интерфейса: ") + ui_lang_label(),
						tr("Back to menu", "Вернуться в меню")
					};
					game_menu.set_items(back);
					audio.speak(tr("Interface language: ", "Язык интерфейса: ") + ui_lang_label(), true);
					audio.speak(tr("This game is now in English.", "Игра теперь на русском языке."), true);
				} else if (sel == 6) {
					game_menu.close();
					show_main_menu();
					return;
				}
			}
			if (key_pressed(KEY_ESCAPE)) {
				game_menu.close();
				show_main_menu();
				return;
			}
			if (key_pressed(KEY_LEFT)) audio.history_back();
			if (key_pressed(KEY_RIGHT)) audio.history_forward();
		}
	}

	private void music_adjust(int step) {
		int new_level = music_level + step;
		if (new_level < 0) new_level = 0;
		if (new_level > 2) new_level = 2;
		if (new_level != music_level) {
			music_level = new_level;
			apply_music_volume();
			save_settings();
		}
		audio.speak(tr("Music: ", "Музыка: ") + music_label(), true);
	}

	private void show_lab_menu() {
		string[] items = {
			tr("Password bruteforce", "Подбор пароля (bruteforce)"),
			tr("Encryption crack", "Взлом шифрования (crack)"),
			tr("Firewall bypass", "Обход фаервола (firewall)"),
			tr("Port scanning", "Сканирование портов"),
			tr("Back to menu", "Вернуться в меню")
		};
		game_menu.set_items(items);
		game_menu.open();

		while (game_menu.is_active()) {
			wait(5);
g_touch.monitor();
			if (key_pressed(KEY_UP)) game_menu.move_up();
			if (key_pressed(KEY_DOWN)) game_menu.move_down();
			if (key_pressed(KEY_HOME)) game_menu.move_first();
			if (key_pressed(KEY_END)) game_menu.move_last();
			if (key_pressed(KEY_PAGEUP)) music_adjust(1);
			if (key_pressed(KEY_PAGEDOWN)) music_adjust(-1);
			if (key_pressed(KEY_RETURN)) {
				int sel = game_menu.get_selected();
				game_menu.close();
				if (sel == 0) {
					audio.speak(tr("Password bruteforce training. Difficulty: 3.", "Тренировка подбора пароля. Сложность: 3."), true);
					hacking.bruteforce(3);
					show_lab_menu();
				} else if (sel == 1) {
					audio.speak(tr("Encryption crack training. Difficulty: 3.", "Тренировка взлома шифрования. Сложность: 3."), true);
					hacking.crack_encryption(3);
					show_lab_menu();
				} else if (sel == 2) {
					audio.speak(tr("Firewall bypass training. Difficulty: 3.", "Тренировка обхода фаервола. Сложность: 3."), true);
					hacking.firewall_bypass(3);
					show_lab_menu();
				} else if (sel == 3) {
					hacking.port_scan(5);
					show_lab_menu();
				} else if (sel == 4) {
					show_main_menu();
				}
				return;
			}
			if (key_pressed(KEY_ESCAPE)) {
				game_menu.close();
				show_main_menu();
				return;
			}
			if (key_pressed(KEY_LEFT)) { audio.history_back(); }
			if (key_pressed(KEY_RIGHT)) { audio.history_forward(); }
		}
	}

	private void init_terminal_commands() {
		terminal.add_command_silent("scan");
		terminal.add_command_silent("connect");
		terminal.add_command_silent("enum");
		terminal.add_command_silent("firewall");
		terminal.add_command_silent("bruteforce");
		terminal.add_command_silent("crack");
		terminal.add_command_silent("download");
		terminal.add_command_silent("spam");
		terminal.add_command_silent("disconnect");
		terminal.add_command_silent("help");
	}

	private void begin_terminal() {
		terminal.clear();
		terminal.set_hostname("localhost");
		if (terminal.command_count() == 0) {
			init_terminal_commands();
		}
		audio.speak(tr("Terminal ready. Arrows — choose, Enter — run. Keys: S E C F B K M D X H. Tab — switch focus.", "Терминал готов. Стрелки — выбрать, Enter — выполнить. Клавиши: S E C F B K M D X H. Tab — навигация."), true);
	}

	private void handle_input() {
		if (key_pressed(KEY_LEFT)) {
			audio.history_back();
			wait(100);
			return;
		}
		if (key_pressed(KEY_RIGHT)) {
			audio.history_forward();
			wait(100);
			return;
		}

		if (key_pressed(KEY_PAGEUP)) {
			music_adjust(1);
			return;
		}
		if (key_pressed(KEY_PAGEDOWN)) {
			music_adjust(-1);
			return;
		}

		if (context_menu.is_active()) {
			handle_context_menu();
			return;
		}
		if (game_menu.is_active()) return;

		if (key_pressed(KEY_APPLICATION)) {
			show_context_menu();
			return;
		}

		if (key_pressed(KEY_TAB)) {
			if (focus == FOCUS_TERMINAL) {
				focus = FOCUS_RESULTS;
				audio.terminal_click();
				audio.speak(tr("Results", "Результаты"), true);
			} else {
				focus = FOCUS_TERMINAL;
				audio.terminal_click();
				audio.speak(tr("Command input", "Ввод команд"), true);
			}
			wait(150);
			return;
		}
		if (key_pressed(KEY_ESCAPE)) {
			if (connected) {
				disconnect();
			} else {
				show_main_menu();
			}
			return;
		}

		if (focus == FOCUS_TERMINAL) {
			handle_terminal_nav();
		} else if (focus == FOCUS_RESULTS) {
			handle_results_nav();
		}
	}

	private void handle_terminal_nav() {
		if (key_pressed(KEY_UP) || key_pressed(KEY_LEFTBRACKET)) {
			terminal.move_up();
			return;
		}
		if (key_pressed(KEY_DOWN) || key_pressed(KEY_RIGHTBRACKET)) {
			terminal.move_down();
			return;
		}
		if (key_pressed(KEY_RETURN)) {
			if (terminal.has_commands()) {
				string cmd = terminal.get_current();
				terminal.execute();
				run_command(cmd);
			}
			return;
		}

		string cmd_name = "";
		if (key_pressed(KEY_S)) { cmd_name = "scan"; }
		else if (key_pressed(KEY_C)) { cmd_name = "connect"; }
		else if (key_pressed(KEY_E)) { cmd_name = "enum"; }
		else if (key_pressed(KEY_F)) { cmd_name = "firewall"; }
		else if (key_pressed(KEY_B)) { cmd_name = "bruteforce"; }
		else if (key_pressed(KEY_K)) { cmd_name = "crack"; }
		else if (key_pressed(KEY_M)) { cmd_name = "spam"; }
		else if (key_pressed(KEY_D)) { cmd_name = "download"; }
		else if (key_pressed(KEY_X)) { cmd_name = "disconnect"; }
		else if (key_pressed(KEY_H)) { cmd_name = "help"; }

		if (cmd_name != "") {
			terminal.add_command_silent(cmd_name);
			audio.speak(cmd_name, true);
			wait(150);
			run_command(cmd_name);
		}
	}

	private void init_tts_voice() {
		// Without a screen reader NVGT falls back to SAPI; its default voice
		// is the unusable "builtin fallback" which garbles Russian text.
		// Prefer a real voice in the chosen language, adjust SAPI loudness.
		use_sr = (voice_mode == 0);
		int first_real = -1;
		int best = -1;
		for (int i = 0; i < tts.get_voice_count(); i++) {
			string n = tts.get_voice_name(i).lower();
			if (n.find("builtin") >= 0) continue;
			if (first_real < 0) first_real = i;
			int score = 0;
			if (speech_language == 0) {
				if (n.find("irina") >= 0 || n.find("pavel") >= 0 || n.find("natalia") >= 0 || n.find("полина") >= 0) score = 2;
				else if (n.find("russian") >= 0 || n.find("русский") >= 0 || n.find("ru") >= 0) score = 1;
			} else {
				if (n.find("david") >= 0 || n.find("zira") >= 0 || n.find("mark") >= 0 || n.find("hazel") >= 0 || n.find("george") >= 0) score = 2;
				else if (n.find("english") >= 0) score = 1;
			}
			if (score > 0 && (best < 0 || score > 1)) best = i;
		}
		int chosen = best >= 0 ? best : first_real;
		if (chosen >= 0) {
			tts.set_voice(chosen);
			log.log("TTS voice: " + tts.get_voice_name(chosen));
		}
		if (voice_mode == 1) {
			tts.volume = speech_volume == 1 ? 0.0 : (speech_volume == 2 ? -8.0 : -3.0);
		}
	}

	private void run_command(string name) {
		log.log("run_command: " + name);

		if (name == "help") {
			cmd_help.execute(mode_to_string(), connected, network.get_current());
			return;
		}

		if (name == "disconnect") {
			cmd_disconnect.execute(mode_to_string(), connected, network.get_current());
			if (connected) {
				connected = false;
				terminal.set_hostname("localhost");
				terminal.clear();
				focus = FOCUS_TERMINAL;
			}
			return;
		}

		if (name == "scan") {
			// Don't scan if connected to a compromised server
			if (connected) {
				Server@ s = network.get_current();
				if (@s != null && s.compromised) {
					audio.terminal_beep();
					audio.speak(tr("Server already hacked. Disconnect (X) to scan new targets.", "Сервер уже взломан. Отключитесь (X) для сканирования новых целей."), true);
					return;
				}
				// Disconnect before scanning new network
				disconnect();
			}

			cmd_scan.execute(mode_to_string(), connected, network.get_current());

			int count;
			if (mode == MODE_STORY) {
				Mission@ m = story.get_current_mission();
				count = m is null ? 3 : m.target_count + 1;
				network.generate(count);
			} else if (mode == MODE_SANDBOX) {
				count = sandbox.get_server_count();
				network.generate_scenario(count, sandbox.get_target_type(), sandbox.get_ids_level());
			} else {
				count = 3;
				network.generate(count);
			}
			wait(300);
			audio.play_sound("target_found");
			audio.speak(tr("Found ", "Найдено ") + network.server_count() + tr(" servers.", " серверов."), false);
			for (int i = 0; i < network.server_count(); i++) {
				Server@ s = network.get_server(i);
				if (@s != null) {
					wait(200);
					audio.terminal_click();
					audio.speak(tr("Server ", "Сервер ") + (i + 1) + ": " + s.hostname + " [" + s.ip + "]", true);
				}
			}
			wait(150);
			focus = FOCUS_RESULTS;
			current_server = 0;
			Server@ s = network.get_server(0);
			if (@s != null) audio.speak(tr("Selected: ", "Выбран: ") + s.hostname, false);

			// In sandbox mode after scan, add more servers if pool getting low
			if (mode == MODE_SANDBOX) {
				check_sandbox_refill();
			}
			return;
		}

		if (name == "connect") {
			if (current_server < 0 || network.server_count() == 0) {
				audio.error_beep();
				audio.speak(tr("No servers. Run scan first.", "Нет серверов. Сначала scan."), true);
				return;
			}
			Server@ s = network.get_server(current_server);
			if (@s == null) return;
			if (s.compromised) {
				audio.speak(tr("Server already hacked. Pick another.", "Сервер уже взломан. Выберите другой."), true);
				return;
			}
			terminal.set_hostname(s.hostname);
			connected = true;
			network.set_current(current_server);
			audio.access_granted();
			audio.speak(tr("Connected to ", "Подключён к ") + s.hostname + tr(". Protection: firewall ", ". Защита: фаервол ") + s.firewall_strength + tr(", encryption ", ", шифрование ") + s.encryption_level + ".", true);
			return;
		}

		Server@ cur = network.get_current();
		if (name == "enum") { cmd_enum.execute(mode_to_string(), connected, cur); }
		else if (name == "firewall") { cmd_firewall.execute(mode_to_string(), connected, cur); }
		else if (name == "bruteforce") {
			if (cur is null || !connected) {
				audio.error_beep();
				audio.speak(tr("No connection.", "Нет подключения."), true);
				return;
			}
			cmd_bruteforce.execute(mode_to_string(), connected, cur);
		}
		else if (name == "spam") { cmd_spam.execute(mode_to_string(), connected, cur); }
		else if (name == "crack") {
			bool ok = cmd_crack.execute(mode_to_string(), connected, cur);
			if (ok && mode == MODE_SANDBOX) {
				check_sandbox_refill();
			}
		}
		else if (name == "download") {
			bool ok = cmd_download.execute(mode_to_string(), connected, cur);
			if (ok && mode == MODE_STORY) {
				Mission@ m = story.get_current_mission();
				if (@m != null) {
					story.complete_mission(story.get_current_index());
					audio.play_sound("mission_success");
					audio.speak(tr("Mission ", "Миссия ") + (story.get_current_index() + 1) + tr(" complete. Reputation: ", " выполнена. Репутация: ") + story.get_reputation(), true);
					if (story.has_next()) {
						story.advance();
						Mission@ next = story.get_current_mission();
						if (@next != null) {
							audio.play_sound("mission_new");
							audio.speak(tr("New mission: ", "Новая миссия: ") + next.title + ". " + next.description, true);
						}
						// Disconnect so player can scan new targets
						disconnect();
					} else {
						audio.speak(tr("All missions complete! You are a master hacker.", "Все миссии пройдены! Вы — мастер хакер."), true);
						audio.success_beep();
					}
				}
			}
			if (ok && mode == MODE_SANDBOX) {
				audio.speak(tr("Data downloaded. Find a new server.", "Данные скачаны. Ищите новый сервер."), true);
				check_sandbox_refill();
			}
		}
	}

	// Refill sandbox: if most servers compromised, generate new ones
	private void check_sandbox_refill() {
		if (mode != MODE_SANDBOX) return;
		int total = network.server_count();
		int compromised = 0;
		for (int i = 0; i < total; i++) {
			Server@ s = network.get_server(i);
			if (@s != null && s.compromised) compromised++;
		}
		if (compromised >= total - 1 && total >= 2) {
			string type_name = sandbox.get_target_type();
			audio.speak(tr("Most targets hacked. Generating new ones...", "Большинство целей взломано. Генерирую новые..."), true);
			wait(300);
			audio.power_up();
			network.generate_scenario(sandbox.get_server_count(), type_name, sandbox.get_ids_level());
			audio.speak(tr("New network: ", "Новая сеть: ") + sandbox.get_server_count() + tr(" targets.", " целей."), true);
			if (connected) {
				connected = false;
				terminal.set_hostname("localhost");
				terminal.clear();
				focus = FOCUS_TERMINAL;
			}
			current_server = 0;
		}
	}

	private string mode_to_string() {
		if (mode == MODE_STORY) return "story";
		if (mode == MODE_SANDBOX) return "sandbox";
		if (mode == MODE_LAB) return "lab";
		return "none";
	}

	private void handle_results_nav() {
		if (key_pressed(KEY_UP) || key_pressed(KEY_LEFTBRACKET)) {
			if (current_server > -1) {
				current_server = current_server > 0 ? current_server - 1 : 0;
				Server@ s = network.get_server(current_server);
				if (@s != null) {
					string status = s.compromised ? tr(", hacked", ", взломан") : "";
					audio.speak(tr("Server ", "Сервер ") + s.hostname + " [" + s.ip + "]" + status, true);
				}
			} else {
				audio.terminal_beep();
			}
			wait(120);
		}
		if (key_pressed(KEY_DOWN) || key_pressed(KEY_RIGHTBRACKET)) {
			if (current_server > -1 && current_server < network.server_count() - 1) {
				current_server++;
				Server@ s = network.get_server(current_server);
				if (@s != null) {
					string status = s.compromised ? tr(", hacked", ", взломан") : "";
					audio.speak(tr("Server ", "Сервер ") + s.hostname + " [" + s.ip + "]" + status, true);
				}
			} else {
				audio.terminal_beep();
			}
			wait(120);
		}
	}

	private void disconnect() {
		audio.disconnect_sound();
		terminal.set_hostname("localhost");
		connected = false;
		terminal.clear();
		focus = FOCUS_TERMINAL;
		audio.speak(tr("Disconnected.", "Отключено."), true);
	}

	private void show_context_menu() {
		string[] items;
		if (mode == MODE_STORY) {
			items = {tr("Back to terminal", "Вернуться в терминал"), tr("Mission status", "Статус миссии"), tr("Main menu", "Главное меню")};
		} else if (mode == MODE_SANDBOX) {
			items = {tr("Back to terminal", "Вернуться в терминал"), tr("Sandbox setup", "Настройка песочницы"), tr("Main menu", "Главное меню")};
		} else if (mode == MODE_LAB) {
			items = {tr("Back to terminal", "Вернуться в терминал"), tr("Lab", "Лаборатория"), tr("Main menu", "Главное меню")};
		} else {
			items = {tr("Back to terminal", "Вернуться в терминал"), tr("Main menu", "Главное меню")};
		}
		context_menu.set_items(items);
		context_menu.open();
	}

	private void handle_context_menu() {
		if (key_pressed(KEY_UP)) {
			context_menu.move_up();
			wait(120);
		}
		if (key_pressed(KEY_DOWN)) {
			context_menu.move_down();
			wait(120);
		}
		if (key_pressed(KEY_HOME)) {
			context_menu.move_first();
			wait(120);
		}
		if (key_pressed(KEY_END)) {
			context_menu.move_last();
			wait(120);
		}
		if (key_pressed(KEY_PAGEUP)) music_adjust(1);
		if (key_pressed(KEY_PAGEDOWN)) music_adjust(-1);
		if (key_pressed(KEY_RETURN)) {
			int sel = context_menu.get_selected();
			context_menu.close();
			int total = mode == MODE_NONE ? 2 : 3;
			if (sel == total - 1) {
				mode = MODE_NONE;
				disconnect();
				show_main_menu();
			} else if (sel == 1) {
				if (mode == MODE_STORY) show_mission_status();
				else if (mode == MODE_SANDBOX) {
					if (connected) disconnect();
					set_sandbox_params();
					init_sandbox_network();
					begin_terminal();
				} else if (mode == MODE_LAB) {
					show_lab_menu();
				}
			}
			return;
		}
		if (key_pressed(KEY_ESCAPE)) {
			context_menu.close();
		}
		if (key_pressed(KEY_LEFT)) {
			audio.history_back();
		}
		if (key_pressed(KEY_RIGHT)) {
			audio.history_forward();
		}
	}

	private void show_mission_status() {
		audio.speak(tr("Mission ", "Миссия ") + (story.get_current_index() + 1) + tr(" of ", " из ") + story.get_mission_count(), true);
		Mission@ m = story.get_current_mission();
		if (@m != null) {
			audio.speak(tr("Current: ", "Текущая: ") + m.title, true);
		}
		int completed_count = 0;
		for (int i = 0; i < story.get_mission_count(); i++) {
			if (story.is_completed(i)) completed_count++;
		}
		audio.speak(tr("Completed: ", "Выполнено: ") + completed_count + tr(". Reputation: ", ". Репутация: ") + story.get_reputation(), true);
	}
};

void main() {
	HackerGame game;
	game.run();
}
