class Command {
	protected AudioManager@ audio;
	protected Network@ network;
	protected HackingGame@ hacking;
	protected StoryManager@ story;
	protected Sandbox@ sandbox;

	string name;
	string hint;

	void setup(AudioManager@ a, Network@ n, HackingGame@ h, StoryManager@ s, Sandbox@ sb) {
		@audio = @a;
		@network = @n;
		@hacking = @h;
		@story = @s;
		@sandbox = @sb;
	}

	bool execute(string mode, bool connected, Server@ current) { return false; }
};

class ScanCommand : Command {
	ScanCommand() {
		name = "scan";
		hint = "S: сканировать цели";
	}

	bool execute(string mode, bool connected, Server@ current) {
		audio.scan_sweep();
		return true;
	}
};

class ConnectCommand : Command {
	ConnectCommand() {
		name = "connect";
		hint = "C: подключиться к цели";
	}

	bool execute(string mode, bool connected, Server@ current) {
		return false;
	}
};

class EnumCommand : Command {
	EnumCommand() {
		name = "enum";
		hint = "E: перечислить порты";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (current.target_type == "person") {
			audio.speak("Сбор информации о цели " + current.hostname, true);
			audio.speak("Доверие: " + current.trust_level + "/5, Осторожность: " + current.encryption_level + "/5", true);
		} else if (current.target_type == "system") {
			audio.speak("Сканирование системы " + current.hostname, true);
			audio.speak("Уровень мониторинга: " + current.monitoring_level + "/5", true);
			hacking.port_scan(current.open_ports.length());
		} else {
			hacking.port_scan(current.open_ports.length());
		}
		return true;
	}
};

class FirewallCommand : Command {
	FirewallCommand() {
		name = "firewall";
		hint = "F: обход защиты";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (current.compromised) {
			audio.speak("Цель уже взломана.", true);
			return false;
		}
		if (current.firewall_bypassed) {
			audio.speak("Защита уже обойдена. Используйте B для подбора.", true);
			return false;
		}
		string type_name = current.target_type == "person" ? "доверия" : current.target_type == "system" ? "мониторинга" : "фаервола";
		audio.speak("Обход " + type_name + ".", true);
		bool ok = hacking.firewall_bypass(current.firewall_strength);
		if (ok) {
			current.firewall_bypassed = true;
			audio.speak("Обход успешен. Используйте B для подбора доступа.", true);
		} else {
			current.alert_ids();
			if (mode == "story") {
				audio.speak("Осторожно! Повторная попытка привлечёт внимание.", false);
			}
		}
		return true;
	}
};

class BruteforceCommand : Command {
	BruteforceCommand() {
		name = "bruteforce";
		hint = "B: подбор доступа";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (current.compromised) {
			audio.speak("Цель уже взломана.", true);
			return false;
		}
		if (!current.firewall_bypassed) {
			audio.error_beep();
			audio.speak("Сначала обойдите защиту (F).", true);
			return false;
		}
		if (current.password_cracked) {
			audio.speak("Пароль уже подобран. Используйте K для взлома шифрования.", true);
			return false;
		}
		if (current.alerted && random(1, 100) > 70) {
			audio.alert_beep();
			audio.speak("IDS засекла подбор! Соединение сброшено.", true);
			return false;
		}
		string action = current.target_type == "person" ? "социальная инженерия" : "подбор пароля";
		audio.speak(action, true);
		if (hacking.bruteforce(current.security_level)) {
			current.password_cracked = true;
			audio.speak("Доступ получен! Используйте K для взлома шифрования.", true);
		} else {
			audio.error_beep();
			if (current.alerted) {
				audio.speak("Слишком много попыток! Цель насторожена.", true);
			}
		}
		return true;
	}
};

class CrackCommand : Command {
	CrackCommand() {
		name = "crack";
		hint = "K: взлом шифрования";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (current.compromised) {
			audio.speak("Цель уже взломана.", true);
			return false;
		}
		if (!current.firewall_bypassed) {
			audio.error_beep();
			audio.speak("Сначала обойдите защиту (F).", true);
			return false;
		}
		if (!current.password_cracked) {
			audio.error_beep();
			audio.speak("Сначала подберите доступ (B).", true);
			return false;
		}
		string action = current.target_type == "person" ? "психологическое давление" : "взлом шифрования";
		audio.speak(action + " на " + current.hostname, true);
		if (hacking.crack_encryption(current.encryption_level)) {
			current.compromised = true;
			audio.speak(current.target_type == "person" ? "Цель сломлена. Все данные доступны." : "Шифрование взломано. Сервер скомпрометирован.", true);
		} else {
			audio.error_beep();
			audio.speak("Взлом не удался.", true);
			if (current.monitoring_level > 3) {
				current.alert_ids();
			}
		}
		return true;
	}
};

class DownloadCommand : Command {
	DownloadCommand() {
		name = "download";
		hint = "D: скачать данные";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (!current.compromised) {
			audio.error_beep();
			audio.speak("Цель не взломана! Цепочка: F (защита) → B (доступ) → K (шифрование) → D (скачать).", true);
			return false;
		}
		string data_name = current.target_type == "person" ? "личных данных" : current.target_type == "system" ? "системных логов" : "файлов";
		audio.speak("Скачивание " + data_name + ". " + current.files.length() + " объектов...", true);
		int count = 0;
		for (uint i = 0; i < current.files.length(); i++) {
			wait(200);
			audio.terminal_click();
			audio.speak(current.files[i], true);
			count++;
		}
		if (current.target_type == "person") {
			audio.speak("Компромат на " + current.hostname + " получен.", true);
		} else if (current.target_type == "system") {
			audio.speak("Система " + current.hostname + " скомпрометирована. Логи скачаны.", true);
		}
		audio.success_beep();
		audio.speak("Извлечено " + count + " объектов. Миссия выполнена.", false);
		return true;
	}
};

class SpamCommand : Command {
	SpamCommand() {
		name = "spam";
		hint = "M: спам/атака на цель";
	}

	bool execute(string mode, bool connected, Server@ current) {
		if (!connected || @current == null) {
			audio.error_beep();
			audio.speak("Нет подключения.", true);
			return false;
		}
		if (current.target_type == "person") {
			audio.speak("Запуск спам-рассылки на " + current.hostname, true);
			wait(300);
			audio.terminal_click();
			audio.speak("Отправлено: фальшивый счёт", true);
			wait(200);
			audio.terminal_click();
			audio.speak("Отправлено: предложение о работе", true);
			wait(200);
			audio.terminal_click();
			audio.speak("Отправлено: уведомление о взломе", true);
			wait(200);
			current.trust_level = current.trust_level > 1 ? current.trust_level - 1 : 1;
			audio.speak("Доверие цели снижено до " + current.trust_level, true);
			return true;
		} else if (current.target_type == "system") {
			audio.speak("Заполнение логов мусором на " + current.hostname, true);
			wait(300);
			audio.explosion_sound();
			audio.speak("Логи переполнены. Мониторинг ослеплён.", true);
			current.monitoring_level = current.monitoring_level > 1 ? current.monitoring_level - 1 : 0;
			return true;
		} else {
			audio.speak("DDoS-атака на порты " + current.hostname, true);
			wait(200);
			audio.laser_large();
			for (uint i = 0; i < current.open_ports.length(); i++) {
				wait(150);
				audio.terminal_click();
				audio.speak("Порт " + current.open_ports[i] + " забросан", true);
			}
			audio.speak("DDoS завершён. Защита ослаблена.", true);
			if (current.firewall_strength > 1) current.firewall_strength = current.firewall_strength - 1;
			return true;
		}
	}
};

class HelpCommand : Command {
	HelpCommand() {
		name = "help";
		hint = "H: список команд";
	}

	bool execute(string mode, bool connected, Server@ current) {
		audio.speak("Команды: S — сканировать, C — подключиться, E — порты/инфо, F — обход защиты, B — подбор доступа, K — взлом, D — скачать, X — отключиться, H — помощь, контекстное меню — App.", true);
		if (connected && @current != null) {
			if (current.target_type == "person") audio.speak("Цель: человек. Тактика: F(доверие) → B(соц.инженерия) → K(давление) → D(компромат).", false);
			else if (current.target_type == "system") audio.speak("Цель: система. Тактика: F(мониторинг) → B(эксплойт) → K(шифрование) → D(логи).", false);
			else audio.speak("Цель: сервер. Тактика: F(фаервол) → B(пароль) → K(шифрование) → D(файлы).", false);
		}
		return true;
	}
};

class DisconnectCommand : Command {
	DisconnectCommand() {
		name = "disconnect";
		hint = "X: отключиться";
	}

	bool execute(string mode, bool connected, Server@ current) {
		audio.disconnect_sound();
		audio.speak("Отключено.", true);
		return true;
	}
};
