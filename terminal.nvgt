class Terminal {
	private string[] commands;
	private string[] history;
	private string[] all_commands;
	private uint cursor;
	private uint top;
	private string prompt;
	private AudioManager@ audio;
	private bool connected;

	Terminal(AudioManager@ a) {
		@audio = @a;
		prompt = ">";
		cursor = 0;
		top = 0;
		connected = false;
		history.resize(0);
		commands.resize(0);
		all_commands.resize(0);
	}

	void set_hostname(string name) {
		prompt = name + ">";
	}

	void clear() {
		commands.resize(0);
		if (all_commands.length() > 0) cursor = all_commands.length() - 1;
		else cursor = 0;
		top = 0;
	}

	void add_command(string cmd) {
		commands.insert_last(cmd);
		all_commands.insert_last(cmd);
		if (top == 0 && commands.length() > 1) top = 0;
		cursor = all_commands.length() - 1;
		audio.terminal_click();
	}

	void add_command_silent(string cmd) {
		commands.insert_last(cmd);
		all_commands.insert_last(cmd);
		if (top == 0 && commands.length() > 1) top = 0;
		cursor = all_commands.length() - 1;
	}

	string get_current() {
		if (all_commands.length() == 0) return "";
		return all_commands[cursor];
	}

	bool move_up() {
		if (cursor > 0) {
			cursor--;
			audio.terminal_click();
			audio.speak(all_commands[cursor], true);
			return true;
		}
		return false;
	}

	bool move_down() {
		if (cursor + 1 < all_commands.length()) {
			cursor++;
			audio.terminal_click();
			audio.speak(all_commands[cursor], true);
			return true;
		}
		return false;
	}

	void execute() {
		if (all_commands.length() == 0) {
			audio.terminal_beep();
			return;
		}
		string cmd = all_commands[cursor];
		history.insert_last(cmd);
		audio.success_beep();
	}

	bool has_commands() {
		return all_commands.length() > 0;
	}

	int command_count() {
		return int(all_commands.length());
	}

	void set_connected(bool state) {
		connected = state;
	}
};
